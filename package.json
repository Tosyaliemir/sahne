{
  "name": "sahne",
  "version": "0.2.0",
  "description": "Synchronized, animated lyrics and ambient colors for your desktop music player",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "preview:fixture": "node dev-tools/preview/make-fixture.mjs",
    "screenshots": "node dev-tools/screenshots/capture.mjs",
    "visual": "node dev-tools/visual/check.mjs",
    "coverage": "vitest run --coverage",
    "release": "node dev-tools/release/release.mjs"
  },
  "//": "MIT, except for the third-party files listed in THIRD_PARTY_NOTICES.md, which keep their own licences.",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "private": true,
  "repository": "https://github.com/Tosyaliemir/sahne"
}
