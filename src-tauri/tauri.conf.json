{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sahne",
  "version": "0.1.0",
  "identifier": "dev.sahne.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sahne",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/sahne/art/**",
          "$CACHE/sahne/cache/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Music",
    "shortDescription": "Spotify için animasyonlu sözler ve ortam renkleri",
    "longDescription": "Sahne, Spotify'da (veya sistem medya kontrollerine bağlanan başka bir oynatıcıda) çalan şarkının sözlerini senkronize ve kelime kelime animasyonlu olarak tam ekranda gösterir; arka planı albüm kapağının renklerine büründürür.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "sound"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Sahne",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "sahne"
}
