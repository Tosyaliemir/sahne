{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sahne",
  "version": "../package.json",
  "identifier": "io.github.tosyaliemir.Sahne",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sahne",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/sahne/art/**",
          "$CACHE/sahne/cache/art/**"
        ]
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Music",
    "shortDescription": "Synchronized, animated lyrics and ambient colors for your desktop music player",
    "longDescription": "Sahne shows the lyrics of whatever is playing in Spotify (or any player that reports to the system media controls) synchronized and animated word by word, over a backdrop made from the album artwork's colors.",
    "license": "MIT",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../src/assets/licenses/rust.txt": "licenses/rust-dependencies.txt",
      "../src/assets/licenses/npm.txt": "licenses/npm-dependencies.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "sound"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Sahne contributors",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    },
    "copyright": "Copyright (c) 2026 Sahne contributors"
  },
  "mainBinaryName": "sahne"
}
